{
  "name": "meagain",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "bun scripts/generate-posts.mjs && next build",
    "dev": "bun scripts/generate-posts.mjs && next dev",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "wrangler d1 migrations apply DB --remote",
    "db:migrate:dev": "wrangler d1 migrations apply DB --local",
    "preview": "bun scripts/generate-posts.mjs && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "bun scripts/generate-posts.mjs && opennextjs-cloudflare build && bun run db:migrate && opennextjs-cloudflare deploy",
    "upload": "bun scripts/generate-posts.mjs && opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.17",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.72.0",
    "next": "16.2.10",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "rehype-highlight": "^7.0.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "wrangler": "^4.161.0"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
